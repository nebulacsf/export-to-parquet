# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=asterisk

# Source table (optional schema prefix: database.table)
DB_TABLE=vicidial_log_archive

# ORDER BY clause used for the export.
# Leave empty to skip it: sorting a very large table can be slower than the
# export itself because MySQL has to spill the sort to disk.
DB_ORDER_BY=call_date ASC

# Export tuning
# Rows read per batch. Smaller values use less RAM, larger values are faster.
DB_CHUNK_SIZE=500000
# snappy, zstd, gzip, brotli, lz4 or none
PARQUET_COMPRESSION=snappy

# Directory used when a bare filename is given instead of a full path,
# e.g. `python main.py archive.parquet` writes to
# /var/backups/vicidial/archive.parquet
OUTPUT_DIR=/var/backups/vicidial

# Log verbosity: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
